<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de backup para Android 11 e inferior.
    Se excluye todo: los CSV contienen datos biométricos que no deben
    sincronizarse automáticamente a Google Drive.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
